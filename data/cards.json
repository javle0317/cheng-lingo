   "id": "ja-1-hiragana",
   "lang": "ja",
   "title": "平假名",
   "order": "seq",
   "cards": [
    {
     "id": "ja-hira-a",
     "type": "word",
     "front": "あ い う え お",
     "reading": "a i u e o",
     "back": "平假名・あ行",
     "note": "あ←安 い←以 う←宇 え←衣 お←於｜母音。う嘴唇不要圓"
    },
    {
     "id": "ja-hira-ka",
     "type": "word",
     "front": "か き く け こ",
     "reading": "ka ki ku ke ko",
     "back": "平假名・か行",
     "note": "か←加 き←幾 く←久 け←計 こ←己"
    },
    {
     "id": "ja-hira-sa",
     "type": "word",
     "front": "さ し す せ そ",
     "reading": "sa shi su se so",
     "back": "平假名・さ行",
     "note": "さ←左 し←之 す←寸 せ←世 そ←曾｜し念 shi。易混：さ vs ち"
    },
    {
     "id": "ja-hira-ta",
     "type": "word",
     "front": "た ち つ て と",
     "reading": "ta chi tsu te to",
     "back": "平假名・た行",
     "note": "た←太 ち←知 つ←川 て←天 と←止｜ち念 chi、つ念 tsu"
    },
    {
     "id": "ja-hira-na",
     "type": "word",
     "front": "な に ぬ ね の",
     "reading": "na ni nu ne no",
     "back": "平假名・な行",
     "note": "な←奈 に←仁 ぬ←奴 ね←祢 の←乃｜易混：ぬ vs め、ね vs れ vs わ"
    },
    {
     "id": "ja-hira-ha",
     "type": "word",
     "front": "は ひ ふ へ ほ",
     "reading": "ha hi fu he ho",
     "back": "平假名・は行",
     "note": "は←波 ひ←比 ふ←不 へ←部 ほ←保｜ふ念 fu；は當助詞念 wa、へ當助詞念 e。易混：は vs ほ"
    },
    {
     "id": "ja-hira-ma",
     "type": "word",
     "front": "ま み む め も",
     "reading": "ma mi mu me mo",
     "back": "平假名・ま行",
     "note": "ま←末 み←美 む←武 め←女 も←毛｜易混：め vs ぬ"
    },
    {
     "id": "ja-hira-ya",
     "type": "word",
     "front": "や ゆ よ",
     "reading": "ya yu yo",
     "back": "平假名・や行",
     "note": "や←也 ゆ←由 よ←與｜只有三個字"
    },
    {
     "id": "ja-hira-ra",
     "type": "word",
     "front": "ら り る れ ろ",
     "reading": "ra ri ru re ro",
     "back": "平假名・ら行",
     "note": "ら←良 り←利 る←留 れ←礼 ろ←呂｜舌尖輕彈，介於 r 和 l。易混：る vs ろ"
    },
    {
     "id": "ja-hira-wa",
     "type": "word",
     "front": "わ を ん",
     "reading": "wa wo n",
     "back": "平假名・わ行",
     "note": "わ←和 を←遠 ん←无｜を念 o，幾乎只當助詞；ん撥音單獨一拍"
    }
   ]
  },
